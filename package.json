{
  "name": "aquatwin",
  "version": "0.1.0",
  "private": true,
  "description": "AquaTwin — AI Irrigation Intelligence Workspace",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "python -m uvicorn app.main:app --app-dir backend --reload --port 8000",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "typecheck": "npm --prefix frontend run typecheck",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "test:backend": "python -m unittest discover -s backend/tests -p \"test_*.py\"",
    "test": "python -m unittest discover -s backend/tests -p \"test_*.py\" && npm --prefix frontend run typecheck"
  }
}
