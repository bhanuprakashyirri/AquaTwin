# AquaTwin environment — copy to .env.local (frontend) and backend/.env (backend)
# The entire demo runs with NO keys required. All values below are optional.

# Frontend
NEXT_PUBLIC_API_BASE=            # leave empty to use built-in deterministic demo engine
NEXT_PUBLIC_DEMO_MODE=true

# Backend (only needed if running the Python service)
GEMINI_API_KEY=                  # optional — explanation layer only, never numeric decisions
REDIS_URL=                       # optional cache (falls back to in-memory)
DATABASE_URL=                    # optional persistence (falls back to in-memory store)
