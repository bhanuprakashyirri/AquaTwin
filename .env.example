# ==========================================
# AquaTwin Environment Configuration Template
# ==========================================
# Copy settings to frontend/.env.local and backend/.env as required.
# Offline demo mode operates deterministically without any third-party credentials.

# ------------------------------------------
# Frontend (Next.js)
# ------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=https://qrvukxxidomhbnkyhxkp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------
# Backend (FastAPI)
# ------------------------------------------
APP_ENV=development
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional backend integrations (Never expose to frontend)
GEMINI_API_KEY=
REDIS_URL=
DATABASE_URL=
