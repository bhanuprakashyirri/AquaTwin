# AquaTwin Backend Environment Configuration
APP_ENV=development
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional backend integrations
# Gemini API key — enables the conversational voice agent (POST /api/agent/chat).
# Leave empty to keep the built-in offline rule-based agent.
GEMINI_API_KEY=
# Gemini model ID for the voice agent (default: gemini-2.5-flash).
GEMINI_MODEL=gemini-2.5-flash
# Optional: override the Gemini REST base URL (e.g. for a proxy).
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
REDIS_URL=
DATABASE_URL=
